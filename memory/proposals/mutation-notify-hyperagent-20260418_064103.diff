+            -H "Content-Type: application/json" \
+            -d "$payload" 2>/dev/null || echo "000")
+
+        # 성공 — 즉시 반환
+        if [ "$http_code" = "200" ]; then
+            log_event "delivered" "\"httpCode\":$http_code,\"attempt\":$attempt"
+            return 0
+        fi
+
+        # 429(요청제한) 또는 5xx(서버오류)만 재시도, 나머지는 즉시 실패
+        if [[ "$http_code" =~ ^(429|5[0-9]{2})$ ]]; then
+            local delay=$((2 ** (attempt - 1)))
+            log_event "retry" "\"httpCode\":$http_code,\"attempt\":$attempt,\"delay_s\":$delay"
+            sleep "$delay"
+            attempt=$((attempt + 1))
+        else
+            break
+        fi
+    done
+
+    log_event "failed" "\"httpCode\":$http_code,\"attempts\":$attempt"
+    return 1
 }
 
