      "agentId": "main",
      "sessionKey": "agent:main:telegram:direct:8137155160",
      "name": "ROS2 데일리 강의",
      "enabled": true,
      "createdAtMs": 1771354103264,
      "updatedAtMs": 1776427261109,
      "schedule": {
